--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -143,6 +143,21 @@ android {
         minSdkVersion 21
         targetSdkVersion 36
 
+        // HumanGram: библиотека HumanGram-Proxy собирается под выбранные
+        // архитектуры. Список задаётся свойством humanGramAbis через -P;
+        // по умолчанию только arm64-v8a, чтобы не тратить время на сборку.
+        // Для универсального APK передаётся
+        // -P humanGramAbis=armeabi-v7a,arm64-v8a,x86,x86_64
+        if (project.hasProperty('humanGramAbis')) {
+            ndk {
+                abiFilters(*project.humanGramAbis.split(',').collect { it.trim() })
+            }
+        } else {
+            ndk {
+                abiFilters 'arm64-v8a'
+            }
+        }
+
         vectorDrawables.generatedDensities = ['mdpi', 'hdpi', 'xhdpi', 'xxhdpi']
 
         multiDexEnabled true
