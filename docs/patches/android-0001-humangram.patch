diff --git a/TMessagesProj/build.gradle b/TMessagesProj/build.gradle
index 85a9f84..eb70ece 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -143,6 +143,21 @@ android {
         minSdkVersion 21
         targetSdkVersion 36
 
+        // HumanGram: библиотека HumanGram-Proxy собирается под выбранные
+        // архитектуры. Список задаётся свойством humanGramAbis через -P;
+        // по умолчанию только arm64-v8a, чтобы не тратить время на сборку.
+        // Для универсального APK передаётся
+        // -P humanGramAbis=armeabi-v7a,arm64-v8a,x86,x86_64
+        if (project.hasProperty('humanGramAbis')) {
+            ndk {
+                abiFilters project.humanGramAbis.split(',').collect { it.trim() }
+            }
+        } else {
+            ndk {
+                abiFilters 'arm64-v8a'
+            }
+        }
+
         vectorDrawables.generatedDensities = ['mdpi', 'hdpi', 'xhdpi', 'xxhdpi']
 
         multiDexEnabled true
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/ApplicationLoader.java b/TMessagesProj/src/main/java/org/telegram/messenger/ApplicationLoader.java
index 5405be7..8cce1c6 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/ApplicationLoader.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/ApplicationLoader.java
@@ -323,6 +323,21 @@ public class ApplicationLoader extends Application {
             applicationContext = getApplicationContext();
         }
 
+        // HumanGram: поднимаем встроенный локальный прокси MTProto
+        // до установки сетевых соединений, чтобы адрес прокси был известен
+        // к моменту инициализации ConnectionsManager. Если библиотека
+        // недоступна, приложение продолжает работу с прямыми подключениями.
+        try {
+            final HumanGramProxy humanGramProxy = HumanGramProxy.start(applicationContext);
+            if (humanGramProxy != null && BuildVars.LOGS_ENABLED) {
+                FileLog.d("HumanGram: proxy at " + humanGramProxy.getAddress());
+            }
+        } catch (Throwable e) {
+            if (BuildVars.LOGS_ENABLED) {
+                FileLog.e(e);
+            }
+        }
+
         NativeLoader.initNativeLibs(ApplicationLoader.applicationContext);
 
         try {
